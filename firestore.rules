rules_version = '2';

// Vault security model (see docs/ADR/0003-ledger-based-permissions.md):
// authorization is decided by Ledger membership. A signed-in user can touch a
// ledger and everything under it only if their uid is in `memberIds`. An invited
// user (email in `invitedEmails`) may read the ledger and accept the invite by
// adding ONLY themselves. Only an owner may delete a ledger.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ledgerData(ledgerId) {
      return get(/databases/$(database)/documents/ledgers/$(ledgerId)).data;
    }

    function isMember(ledgerId) {
      return signedIn() && request.auth.uid in ledgerData(ledgerId).memberIds;
    }

    function isOwner(ledgerId) {
      return signedIn() && ledgerData(ledgerId).members[request.auth.uid] == 'owner';
    }

    // A signed-in invitee joining: may change ONLY members/memberIds/invitedEmails,
    // and only to add themselves (as 'member') and drop their own invited email.
    function isAcceptingInvite(before, after) {
      let uid = request.auth.uid;
      let email = request.auth.token.email.lower();
      return signedIn()
        && email in before.get('invitedEmails', [])
        && !(uid in before.get('memberIds', []))
        && after.diff(before).affectedKeys().hasOnly(['members', 'memberIds', 'invitedEmails'])
        && after.memberIds.hasAll(before.memberIds)
        && after.memberIds.hasOnly(before.memberIds.concat([uid]))
        && after.members.diff(before.members).affectedKeys().hasOnly([uid])
        && after.members[uid] == 'member'
        && after.invitedEmails.hasOnly(before.invitedEmails)
        && !(email in after.invitedEmails);
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /ledgers/{ledgerId} {
      allow read: if signedIn()
        && (request.auth.uid in resource.data.get('memberIds', [])
            || request.auth.token.email.lower() in resource.data.get('invitedEmails', []));

      allow create: if signedIn() && request.auth.uid in request.resource.data.members;

      allow update: if isMember(ledgerId)
        || isAcceptingInvite(resource.data, request.resource.data);

      allow delete: if isOwner(ledgerId);

      match /{document=**} {
        allow read, write: if isMember(ledgerId);
      }
    }
  }
}
