rules_version = '2';

// Vault security model (see docs/ADR/0003-ledger-based-permissions.md):
// authorization is decided by Ledger membership. A signed-in user can touch a
// ledger and everything under it only if their uid is a key in the ledger's
// `members` map. Users own their own `users/{uid}` document.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(ledgerId) {
      return signedIn()
        && request.auth.uid in
           get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.members;
    }

    // A user reads/writes only their own profile document.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /ledgers/{ledgerId} {
      // Access an existing ledger only as a member.
      allow read, update, delete: if isMember(ledgerId);
      // Create a ledger only if you include yourself in its members.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members;

      // Accounts, categories, transactions, etc. inherit ledger membership.
      match /{document=**} {
        allow read, write: if isMember(ledgerId);
      }
    }
  }
}
