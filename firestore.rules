rules_version = '2';

// Vault security model (see docs/ADR/0003-ledger-based-permissions.md):
// authorization is decided by Ledger membership. A signed-in user can touch a
// ledger and everything under it only if their uid is in the ledger's
// `memberIds`. An invited-but-not-yet-joined user (email in `invitedEmails`)
// may read the ledger so they can accept. Users own their own `users/{uid}` doc.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(ledgerId) {
      return signedIn()
        && request.auth.uid in
           get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.memberIds;
    }

    // A user reads/writes only their own profile document.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /ledgers/{ledgerId} {
      // Members can read; an invitee (by email) can read to accept.
      allow read: if signedIn()
        && (request.auth.uid in resource.data.get('memberIds', [])
            || request.auth.token.email in resource.data.get('invitedEmails', []));

      // Create a ledger only if you include yourself in its members.
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;

      // Members can update/delete. (Invite-accept join rules land in the
      // sharing step.)
      allow update, delete: if isMember(ledgerId);

      // Accounts, categories, transactions, recurring inherit ledger membership.
      match /{document=**} {
        allow read, write: if isMember(ledgerId);
      }
    }
  }
}
